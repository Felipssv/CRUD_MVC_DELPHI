implementation

{%CLASSGROUP 'Vcl.Controls.TControl'}
{$R *.dfm}

var
  FInstance: TDmConexao;

procedure TDmConexao.DataModuleCreate(Sender: TObject);
begin
  FdConexao.DriverName                    := 'PG';
  FdConexao.Params.Values['Server']       := 'aws-1-us-east-2.pooler.supabase.com';
  FdConexao.Params.Values['Port']         := '5432';
  FdConexao.Params.Values['Database']     := 'postgres';
