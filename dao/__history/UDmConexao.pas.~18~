  FdConexao.Params.Values['Password']     := 'cruddelphikey';
  FdConexao.Params.Values['CharacterSet'] := 'UTF8';
  FdConexao.Params.Values['SSLMode']      := 'require';
  FdConexao.LoginPrompt                   := False;
  FdConexao.Connected                     := True;
end;

class function TDmConexao.GetInstance: TDmConexao;
begin
  if not Assigned(FInstance) then
    FInstance := TDmConexao.Create(nil);
